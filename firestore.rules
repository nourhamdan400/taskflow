rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(v, max) { return v is string && v.size() <= max; }

    // ---------- users ----------
    // Profile holds only displayName/email/createdAt (no secrets, no passwords).
    // Signed-in users may read profiles so owners can add members by email.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && isStr(request.resource.data.displayName, 1, 80)
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && isStr(request.resource.data.displayName, 1, 80);
      allow delete: if false;
    }

    // ---------- projects ----------
    match /projects/{projectId} {
      function isOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.memberIds; }

      function validProject(d) {
        return isStr(d.name, 3, 80)
          && optStr(d.description, 1000)
          && d.ownerId is string
          && d.memberIds is list
          && d.ownerId in d.memberIds;
      }

      allow read: if isOwner() || isMember();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validProject(request.resource.data)
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Owner only. ownerId and createdAt are immutable; owner stays a member.
      allow update: if isOwner()
        && validProject(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner();

      // ---------- tasks (subcollection) ----------
      match /tasks/{taskId} {
        function project() { return get(/databases/$(database)/documents/projects/$(projectId)).data; }
        function pIsOwner() { return signedIn() && project().ownerId == request.auth.uid; }
        function pIsMember() { return signedIn() && request.auth.uid in project().memberIds; }

        function validTask(d) {
          return isStr(d.title, 3, 120)
            && optStr(d.description, 1000)
            && d.status in ['todo', 'in_progress', 'done']
            && d.priority in ['low', 'medium', 'high']
            && (d.dueDate == null || (d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && (d.assigneeId == null || d.assigneeId in project().memberIds);
        }

        allow read: if pIsMember();

        allow create: if pIsMember()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'todo'
          && validTask(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Owner: any valid edit. Member: only tasks they created or are assigned to;
        // status may change only if the member is the assignee.
        allow update: if pIsMember()
          && validTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (
            pIsOwner()
            || (
              (resource.data.assigneeId == request.auth.uid || resource.data.createdBy == request.auth.uid)
              && (request.resource.data.status == resource.data.status
                  || resource.data.assigneeId == request.auth.uid)
            )
          );

        allow delete: if pIsOwner()
          || (pIsMember() && resource.data.createdBy == request.auth.uid);
      }

      match /activity/{activityId} {
        function isMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds;
        }

        function validActivity(d) {
          return d.keys().hasOnly([
              'taskId', 'taskTitle', 'action', 'fromStatus', 'toStatus', 'actorId', 'createdAt'
            ])
            && isStr(d.taskId, 1, 128)
            && optStr(d.taskTitle, 120)
            && d.action in ['created', 'updated', 'status_changed', 'deleted']
            && (d.fromStatus == null || d.fromStatus in ['todo', 'in_progress', 'done'])
            && (d.toStatus == null || d.toStatus in ['todo', 'in_progress', 'done'])
            && d.actorId == request.auth.uid
            && d.createdAt == request.time;
        }

        allow read: if isMember();
        allow create: if isMember() && validActivity(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
